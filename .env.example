# Token de tu cuenta de Apify (https://console.apify.com/settings/integrations)
APIFY_TOKEN=

# Usuario real de Instagram a monitorear (sin @).
# Se queda SOLO aquí (archivo privado que no se sube a GitHub).
IG_USERNAME=
# Nombre visible en el panel (no revela tu cuenta)
DISPLAY_NAME=IG FV

# Cuántas publicaciones descargar por sincronización
RESULTS_LIMIT=100

# Límites de las listas de seguidores/seguidos
FOLLOWERS_LIMIT=200
FOLLOWING_LIMIT=200

# Comentarios y menciones
COMMENTS_TOP_POSTS=10
COMMENTS_PER_POST=20
MENTIONS_LIMIT=20

# Alertas por Telegram (opcional; crea un bot con @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Notificar si un reel supera este nº de reproducciones (0 = desactivado)
ALERT_VIEWS_THRESHOLD=0
