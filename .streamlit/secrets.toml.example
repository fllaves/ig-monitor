# Copia este archivo a `.streamlit/secrets.toml` para uso LOCAL,
# o pega estos valores en la pantalla "Secrets" de Streamlit Community Cloud.
# ⚠️ NO subas este archivo a un repositorio público.

APIFY_TOKEN = "apify_api_tu_token"
IG_USERNAME = "tu_usuario_ig"
DISPLAY_NAME = "IG FV"

# Base de datos en la nube (Turso). Déjalo vacío para usar SQLite local.
DATABASE_URL = "libsql://tu-base.turso.io"
DATABASE_AUTH_TOKEN = "token-de-turso"

# Alertas Telegram (opcional)
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""
